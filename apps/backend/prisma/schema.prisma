generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  admin
  editor
  viewer
}

enum DnDClass {
  BARBARE
  BARDE
  CLERC
  DRUIDE
  GUERRIER
  MOINE
  PALADIN
  RODEUR
  ROUBLARD
  ENSORCELEUR
  SORCIER
  MAGICIEN
  ARTIFICIER
  OTHER
}

enum DnDAlignment {
  LOYAL_BON
  NEUTRE_BON
  CHAOTIQUE_BON
  LOYAL_NEUTRE
  VRAI_NEUTRE
  CHAOTIQUE_NEUTRE
  LOYAL_MAUVAIS
  NEUTRE_MAUVAIS
  CHAOTIQUE_MAUVAIS
}

enum Breed {
  ELFE
  HALFELIN
  HUMAIN
  NAIN
  DEMI_ELFE
  DEMI_ORC
  DRAKEIDE
  GNOME
  TIEFFELIN
  AASIMAR
  GENASIAIR
  GENASITERRE
  GENASIFEUR
  GENASIEAU
  GOLIATH
  OTHER
}

enum Sex {
  MAN
  WOMAN
  OTHER
}

enum Membership {
  POLITIC
  RELIGEUX
  MARCHAND
  MILITAIRE
  CRIMINALITE
  OTHER
}

enum Language {
  COMMUN
  NAIN
  ELFIQUE
  GNOME
  HALFELIN
  ORC
  GOBELIN
  GEANT
  DRACONIQUE
  SYLVESTRE
  INFERNAL
  ABYSSAL
  CELESTE
  PRIMORDIAL
  AQUAN
  AURAN
  IGNAN
  TERRAN
  PROFOND
  SLAADI
  TELEPATHIQUE
  ARGOT_VOLEUR
}

model User {
  id           String   @id @default(uuid())
  username     String
  email        String   @unique
  passwordHash String
  type         UserType
  comments     Comment[] @relation("UserComments")
}

model Kingdom {
  id          String    @id @default(uuid())
  name        String
  population  Int?
  description String?
  dateInGame  DateTime?
  color       String?   // Couleur appliquée aux icônes des villes du royaume (hex, ex: #1a73e8)
  flag        String?   // URL du drapeau (remplace l’icône sur la carte si défini)
  isForDM     Boolean   @default(false)

  cities           City[]
  places           Place[]
  comments         Comment[]
  persons          PersonOfInterest[]
  playerCharacters PlayerCharacter[]
  position         Position?
  organisations    OrganisationKingdom[]
  lores            LoreKingdom[]
}

model City {
  id          String    @id @default(uuid())
  name        String
  description String?
  iconUrl     String?
  map         String?
  flag        String?   // URL du drapeau (remplace l’icône sur la carte si défini)
  kingdomId   String?
  isForDM     Boolean   @default(false)

  kingdom          Kingdom? @relation(fields: [kingdomId], references: [id])
  places           Place[]
  districts        District[]
  comments         Comment[]
  persons          PersonOfInterest[]
  playerCharacters PlayerCharacter[]
  position         Position?
  organisations    OrganisationCity[]
  lores            LoreCity[]
}

model District {
  id          String  @id @default(uuid())
  name        String
  motto       String?  // Devise/citation du quartier
  ambiance    String?  // Ambiance et description
  content     String?  // Contenu du quartier
  rumors      String?  // Rumeurs et murmures
  secret      String?  // Secret caché
  cityId      String

  city             City      @relation(fields: [cityId], references: [id])
  places           Place[]
  comments         Comment[]
  persons          PersonOfInterest[]
  playerCharacters PlayerCharacter[]
}

enum PlaceType {
  MAGASIN
  TAVERNE_AUBERGE
  MAGASIN_MAGIE
  HERBORISTE_APOTHICAIRE
  DONJON_CAVERNE
  AUTRE
}

model Place {
  id          String     @id @default(uuid())
  name        String
  description String?
  iconUrl     String?
  map         String?
  placeType   PlaceType  @default(AUTRE)
  kingdomId   String?
  cityId      String?
  districtId  String?
  showOnMap   Boolean    @default(true)
  isForDM     Boolean    @default(false)

  kingdom          Kingdom?  @relation(fields: [kingdomId], references: [id])
  city             City?     @relation(fields: [cityId], references: [id])
  district         District? @relation(fields: [districtId], references: [id])
  comments         Comment[]
  persons          PersonOfInterest[]
  playerCharacters PlayerCharacter[]
  position         Position?
  organisations    OrganisationPlace[]
  lores            LorePlace[]
}

model PersonOfInterest {
  id          String      @id @default(uuid())
  name        String
  description String?
  imageUrl    String?
  breed       Breed?
  sex         Sex?
  membership  Membership?
  languages   Language[]
  STR         Int
  DEX         Int
  CON         Int
  INT         Int
  WIS         Int
  CHA         Int
  pv          Int?        // Points de vie
  ca          Int?        // Classe d'armure
  fp          String?     // Facteur de puissance : 1/8, 1/4, 1/2 ou 1–30
  showOnMap   Boolean     @default(true) // Afficher sur la carte
  isForDM     Boolean     @default(false)
  kingdomId   String?
  cityId      String?
  districtId  String?
  placeId     String?

  kingdom  Kingdom?  @relation(fields: [kingdomId], references: [id])
  city     City?     @relation(fields: [cityId], references: [id])
  district District? @relation(fields: [districtId], references: [id])
  place    Place?    @relation(fields: [placeId], references: [id])
  comments Comment[]
  position Position?
  organisations OrganisationMember[]
  lores   LorePerson[]
}

model Comment {
  id                 String   @id @default(uuid())
  description        String
  dateInGame         DateTime?
  kingdomId          String?
  cityId             String?
  districtId         String?
  placeId            String?
  personOfInterestId String?
  authorId           String?

  kingdom          Kingdom?          @relation(fields: [kingdomId], references: [id])
  city             City?             @relation(fields: [cityId], references: [id])
  district         District?         @relation(fields: [districtId], references: [id])
  place            Place?            @relation(fields: [placeId], references: [id])
  personOfInterest PersonOfInterest? @relation(fields: [personOfInterestId], references: [id])
  author           User?             @relation("UserComments", fields: [authorId], references: [id])
}

model Position {
  id                 String   @id @default(uuid())
  x                  Float
  y                  Float
  kingdomId          String? @unique
  cityId             String? @unique
  placeId            String? @unique
  personOfInterestId String? @unique
  playerCharacterId  String? @unique

  kingdom          Kingdom?          @relation(fields: [kingdomId], references: [id])
  city             City?             @relation(fields: [cityId], references: [id])
  place            Place?            @relation(fields: [placeId], references: [id])
  personOfInterest PersonOfInterest? @relation(fields: [personOfInterestId], references: [id])
  playerCharacter  PlayerCharacter?  @relation(fields: [playerCharacterId], references: [id])
}

enum OrganisationType {
  CELLULE
  PRINCIPAL
}

model Organisation {
  id                  String   @id @default(uuid())
  name                String
  description         String?
  organisationType    OrganisationType? // cellule ou principal
  /** Affiliation (politique, religieux, etc.) — même énumération que les personnages. */
  membership          Membership?
  parentOrganisationId String?
  flag                String?  // URL du drapeau (affiché à la place de l’icône si défini)
  isForDM             Boolean  @default(false)

  parentOrganisation  Organisation? @relation("OrganisationHierarchy", fields: [parentOrganisationId], references: [id], onDelete: SetNull)
  subOrganisations    Organisation[] @relation("OrganisationHierarchy")

  members OrganisationMember[]
  cities  OrganisationCity[]
  places  OrganisationPlace[]
  kingdoms OrganisationKingdom[]
  lores   LoreOrganisation[]
}

model OrganisationMember {
  id             String   @id @default(uuid())
  organisationId String
  personId       String

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  person       PersonOfInterest    @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([organisationId, personId])
}

model OrganisationCity {
  id             String   @id @default(uuid())
  organisationId String
  cityId         String

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  city         City         @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([organisationId, cityId])
}

model OrganisationPlace {
  id             String   @id @default(uuid())
  organisationId String
  placeId        String

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  place         Place        @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([organisationId, placeId])
}

model OrganisationKingdom {
  id             String   @id @default(uuid())
  organisationId String
  kingdomId      String

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  kingdom       Kingdom       @relation(fields: [kingdomId], references: [id], onDelete: Cascade)

  @@unique([organisationId, kingdomId])
}

model Lore {
  id         String   @id @default(uuid())
  title      String
  content    String
  tags       String[] @default([])
  dateInGame String?
  summary    String?
  isForDM    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  kingdoms      LoreKingdom[]
  cities        LoreCity[]
  places        LorePlace[]
  persons       LorePerson[]
  organisations LoreOrganisation[]
}

model LoreKingdom {
  id        String  @id @default(uuid())
  loreId    String
  kingdomId String

  lore    Lore    @relation(fields: [loreId], references: [id], onDelete: Cascade)
  kingdom Kingdom @relation(fields: [kingdomId], references: [id], onDelete: Cascade)

  @@unique([loreId, kingdomId])
}

model LoreCity {
  id      String @id @default(uuid())
  loreId  String
  cityId  String

  lore Lore @relation(fields: [loreId], references: [id], onDelete: Cascade)
  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([loreId, cityId])
}

model LorePlace {
  id      String @id @default(uuid())
  loreId  String
  placeId String

  lore  Lore  @relation(fields: [loreId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([loreId, placeId])
}

model LorePerson {
  id       String @id @default(uuid())
  loreId   String
  personId String

  lore   Lore            @relation(fields: [loreId], references: [id], onDelete: Cascade)
  person PersonOfInterest @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([loreId, personId])
}

model LoreOrganisation {
  id             String @id @default(uuid())
  loreId         String
  organisationId String

  lore         Lore         @relation(fields: [loreId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([loreId, organisationId])
}

model PlayerCharacter {
  id          String        @id @default(uuid())
  name        String
  class       DnDClass?
  level       Int           @default(1)
  race        Breed?
  background  String?
  alignment   DnDAlignment?
  imageUrl    String?
  description String?
  STR         Int           @default(10)
  DEX         Int           @default(10)
  CON         Int           @default(10)
  INT         Int           @default(10)
  WIS         Int           @default(10)
  CHA         Int           @default(10)
  pv          Int?
  pvMax       Int?
  ca          Int?
  initiative  Int?
  speed       Int?
  isForDM     Boolean       @default(false)
  showOnMap   Boolean       @default(true)
  kingdomId   String?
  cityId      String?
  districtId  String?
  placeId     String?

  kingdom      Kingdom?  @relation(fields: [kingdomId], references: [id])
  city         City?     @relation(fields: [cityId], references: [id])
  district     District? @relation(fields: [districtId], references: [id])
  place        Place?    @relation(fields: [placeId], references: [id])
  position     Position?
  skills       PlayerCharacterSkill[]
  savingThrows PlayerCharacterSavingThrow[]
  equipment    PlayerCharacterEquipmentItem[]
  spells       PlayerCharacterSpell[]
}

model PlayerCharacterSkill {
  id                String  @id @default(uuid())
  playerCharacterId String
  name              String
  ability           String  @default("DEX") // STR, DEX, CON, INT, WIS, CHA
  proficient        Boolean @default(false)
  expertise         Boolean @default(false)

  playerCharacter PlayerCharacter @relation(fields: [playerCharacterId], references: [id], onDelete: Cascade)
}

model PlayerCharacterSavingThrow {
  id                String  @id @default(uuid())
  playerCharacterId String
  ability           String
  proficient        Boolean @default(false)

  playerCharacter PlayerCharacter @relation(fields: [playerCharacterId], references: [id], onDelete: Cascade)
}

model PlayerCharacterEquipmentItem {
  id                String  @id @default(uuid())
  playerCharacterId String
  name              String
  quantity          Int     @default(1)
  description       String?
  equipped          Boolean @default(false)

  playerCharacter PlayerCharacter @relation(fields: [playerCharacterId], references: [id], onDelete: Cascade)
}

model PlayerCharacterSpell {
  id                String  @id @default(uuid())
  playerCharacterId String
  name              String
  level             Int     @default(0)
  school            String?
  description       String?
  prepared          Boolean @default(false)

  playerCharacter PlayerCharacter @relation(fields: [playerCharacterId], references: [id], onDelete: Cascade)
}
