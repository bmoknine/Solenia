generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  admin
  editor
  viewer
}

enum DnDClass {
  BARBARE
  BARDE
  CLERC
  DRUIDE
  GUERRIER
  MOINE
  PALADIN
  RODEUR
  ROUBLARD
  ENSORCELEUR
  SORCIER
  MAGICIEN
  ARTIFICIER
  OTHER
}

enum DnDAlignment {
  LOYAL_BON
  NEUTRE_BON
  CHAOTIQUE_BON
  LOYAL_NEUTRE
  VRAI_NEUTRE
  CHAOTIQUE_NEUTRE
  LOYAL_MAUVAIS
  NEUTRE_MAUVAIS
  CHAOTIQUE_MAUVAIS
}

enum Breed {
  ELFE
  HALFELIN
  HUMAIN
  NAIN
  DEMI_ELFE
  DEMI_ORC
  DRAKEIDE
  GNOME
  TIEFFELIN
  AASIMAR
  GENASIAIR
  GENASITERRE
  GENASIFEUR
  GENASIEAU
  GOLIATH
  OTHER
}

enum Sex {
  MAN
  WOMAN
  OTHER
}

enum Membership {
  POLITIC
  RELIGEUX
  MARCHAND
  MILITAIRE
  CRIMINALITE
  OTHER
}

enum Language {
  COMMUN
  NAIN
  ELFIQUE
  GNOME
  HALFELIN
  ORC
  GOBELIN
  GEANT
  DRACONIQUE
  SYLVESTRE
  INFERNAL
  ABYSSAL
  CELESTE
  PRIMORDIAL
  AQUAN
  AURAN
  IGNAN
  TERRAN
  PROFOND
  SLAADI
  TELEPATHIQUE
  ARGOT_VOLEUR
}

model User {
  id           String   @id @default(uuid())
  username     String
  email        String   @unique
  passwordHash String
  type         UserType
  comments     Comment[] @relation("UserComments")
}

model Kingdom {
  id          String    @id @default(uuid())
  name        String
  population  Int?
  description String?
  dateInGame  DateTime?
  color       String?   // Couleur appliquée aux icônes des villes du royaume (hex, ex: #1a73e8)
  flag        String?   // URL du drapeau (remplace l’icône sur la carte si défini)
  borderPoints Json?    // Frontière tracée sur la carte : tableau de sommets [x, y] en ratio 0..1
  isForDM     Boolean   @default(false)

  cities           City[]
  places           Place[]
  comments         Comment[]
  persons          PersonOfInterest[]
  playerCharacters PlayerCharacter[]
  position         Position?
  organisations    OrganisationKingdom[]
  lores            LoreKingdom[]
}

model City {
  id          String    @id @default(uuid())
  name        String
  description String?
  iconUrl     String?
  map         String?
  flag        String?   // URL du drapeau (remplace l’icône sur la carte si défini)
  kingdomId   String?
  isForDM     Boolean   @default(false)

  kingdom          Kingdom? @relation(fields: [kingdomId], references: [id])
  places           Place[]
  districts        District[]
  comments         Comment[]
  persons          PersonOfInterest[]
  playerCharacters PlayerCharacter[]
  position         Position?
  organisations    OrganisationCity[]
  lores            LoreCity[]
}

model District {
  id          String  @id @default(uuid())
  name        String
  motto       String?  // Devise/citation du quartier
  ambiance    String?  // Ambiance et description
  content     String?  // Contenu du quartier
  rumors      String?  // Rumeurs et murmures
  secret      String?  // Secret caché
  cityId      String

  city             City      @relation(fields: [cityId], references: [id])
  places           Place[]
  comments         Comment[]
  persons          PersonOfInterest[]
  playerCharacters PlayerCharacter[]
}

enum PlaceType {
  MAGASIN
  TAVERNE_AUBERGE
  MAGASIN_MAGIE
  HERBORISTE_APOTHICAIRE
  DONJON_CAVERNE
  AUTRE
}

model Place {
  id          String     @id @default(uuid())
  name        String
  description String?
  iconUrl     String?
  map         String?
  placeType   PlaceType  @default(AUTRE)
  kingdomId   String?
  cityId      String?
  districtId  String?
  showOnMap   Boolean    @default(true)
  isForDM     Boolean    @default(false)

  kingdom          Kingdom?  @relation(fields: [kingdomId], references: [id])
  city             City?     @relation(fields: [cityId], references: [id])
  district         District? @relation(fields: [districtId], references: [id])
  comments         Comment[]
  persons          PersonOfInterest[]
  playerCharacters PlayerCharacter[]
  position         Position?
  organisations    OrganisationPlace[]
  lores            LorePlace[]
}

model PersonOfInterest {
  id          String      @id @default(uuid())
  name        String
  description String?
  imageUrl    String?
  breed       Breed?
  sex         Sex?
  membership  Membership?
  languages   Language[]
  STR         Int
  DEX         Int
  CON         Int
  INT         Int
  WIS         Int
  CHA         Int
  pv          Int?        // Points de vie
  ca          Int?        // Classe d'armure
  fp          String?     // Facteur de puissance : 1/8, 1/4, 1/2 ou 1–30
  showOnMap   Boolean     @default(true) // Afficher sur la carte
  isForDM     Boolean     @default(false)
  kingdomId   String?
  cityId      String?
  districtId  String?
  placeId     String?

  kingdom  Kingdom?  @relation(fields: [kingdomId], references: [id])
  city     City?     @relation(fields: [cityId], references: [id])
  district District? @relation(fields: [districtId], references: [id])
  place    Place?    @relation(fields: [placeId], references: [id])
  comments Comment[]
  position Position?
  organisations OrganisationMember[]
  lores   LorePerson[]
  combatants Combatant[]
  familyMembers FamilyMember[]
}

model Comment {
  id                 String   @id @default(uuid())
  description        String
  dateInGame         DateTime?
  kingdomId          String?
  cityId             String?
  districtId         String?
  placeId            String?
  personOfInterestId String?
  authorId           String?

  kingdom          Kingdom?          @relation(fields: [kingdomId], references: [id])
  city             City?             @relation(fields: [cityId], references: [id])
  district         District?         @relation(fields: [districtId], references: [id])
  place            Place?            @relation(fields: [placeId], references: [id])
  personOfInterest PersonOfInterest? @relation(fields: [personOfInterestId], references: [id])
  author           User?             @relation("UserComments", fields: [authorId], references: [id])
}

model Position {
  id                 String   @id @default(uuid())
  x                  Float
  y                  Float
  kingdomId          String? @unique
  cityId             String? @unique
  placeId            String? @unique
  personOfInterestId String? @unique
  playerCharacterId  String? @unique

  // Cascade et non SetNull : une position n'existe que pour l'entité qu'elle place.
  // En SetNull, supprimer l'entité laissait une ligne aux cinq clés nulles, que plus
  // rien ne pouvait référencer (27 résidus nettoyés le 2026-09-10).
  kingdom          Kingdom?          @relation(fields: [kingdomId], references: [id], onDelete: Cascade)
  city             City?             @relation(fields: [cityId], references: [id], onDelete: Cascade)
  place            Place?            @relation(fields: [placeId], references: [id], onDelete: Cascade)
  personOfInterest PersonOfInterest? @relation(fields: [personOfInterestId], references: [id], onDelete: Cascade)
  playerCharacter  PlayerCharacter?  @relation(fields: [playerCharacterId], references: [id], onDelete: Cascade)
}

enum OrganisationType {
  CELLULE
  PRINCIPAL
  FAMILLE
}

model Organisation {
  id                  String   @id @default(uuid())
  name                String
  description         String?
  organisationType    OrganisationType? // cellule ou principal
  /** Affiliation (politique, religieux, etc.) — même énumération que les personnages. */
  membership          Membership?
  parentOrganisationId String?
  flag                String?  // URL du drapeau (affiché à la place de l’icône si défini)
  isForDM             Boolean  @default(false)

  parentOrganisation  Organisation? @relation("OrganisationHierarchy", fields: [parentOrganisationId], references: [id], onDelete: SetNull)
  subOrganisations    Organisation[] @relation("OrganisationHierarchy")

  members OrganisationMember[]
  cities  OrganisationCity[]
  places  OrganisationPlace[]
  kingdoms OrganisationKingdom[]
  lores   LoreOrganisation[]
  /** Nœuds de l'arbre généalogique (organisations de type FAMILLE). */
  familyMembers FamilyMember[]
}

/**
 * Nœud d'arbre généalogique rattaché à une famille (Organisation de type FAMILLE).
 * Nœud léger : soit un simple nom (ancêtres), soit un lien vers un PNJ ou un PJ.
 */
model FamilyMember {
  id                String   @id @default(uuid())
  organisationId    String
  name              String
  /** Mention courte affichée sous le nom : « Fondateur », « Grand-père », « ★ PJ »… */
  title             String?
  personId          String?
  playerCharacterId String?
  fatherId          String?
  motherId          String?
  spouseId          String?
  /** Supérieur hiérarchique — utilisé par les organigrammes (organisations non familiales). */
  superiorId        String?
  sex               Sex?
  isFounder         Boolean  @default(false)
  /** Rang de génération forcé ; sinon calculé depuis les parents. */
  generation        Int?
  /** Ordre horizontal au sein de la génération. */
  order             Int      @default(0)
  notes             String?
  isForDM           Boolean  @default(false)
  createdAt         DateTime @default(now())

  organisation    Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  person          PersonOfInterest? @relation(fields: [personId], references: [id], onDelete: SetNull)
  playerCharacter PlayerCharacter?  @relation(fields: [playerCharacterId], references: [id], onDelete: SetNull)

  father   FamilyMember?  @relation("FM_Father", fields: [fatherId], references: [id], onDelete: SetNull)
  mother   FamilyMember?  @relation("FM_Mother", fields: [motherId], references: [id], onDelete: SetNull)
  spouse   FamilyMember?  @relation("FM_Spouse", fields: [spouseId], references: [id], onDelete: SetNull)
  superior FamilyMember?  @relation("FM_Superior", fields: [superiorId], references: [id], onDelete: SetNull)
  childrenAsFather FamilyMember[] @relation("FM_Father")
  childrenAsMother FamilyMember[] @relation("FM_Mother")
  spouseOf         FamilyMember[] @relation("FM_Spouse")
  subordinates     FamilyMember[] @relation("FM_Superior")
}

model OrganisationMember {
  id             String   @id @default(uuid())
  organisationId String
  personId       String

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  person       PersonOfInterest    @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([organisationId, personId])
}

model OrganisationCity {
  id             String   @id @default(uuid())
  organisationId String
  cityId         String

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  city         City         @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([organisationId, cityId])
}

model OrganisationPlace {
  id             String   @id @default(uuid())
  organisationId String
  placeId        String

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  place         Place        @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([organisationId, placeId])
}

model OrganisationKingdom {
  id             String   @id @default(uuid())
  organisationId String
  kingdomId      String

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  kingdom       Kingdom       @relation(fields: [kingdomId], references: [id], onDelete: Cascade)

  @@unique([organisationId, kingdomId])
}

model Lore {
  id         String   @id @default(uuid())
  title      String
  content    String
  tags       String[] @default([])
  dateInGame String?
  summary    String?
  isForDM    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  kingdoms      LoreKingdom[]
  cities        LoreCity[]
  places        LorePlace[]
  persons       LorePerson[]
  organisations LoreOrganisation[]
}

model LoreKingdom {
  id        String  @id @default(uuid())
  loreId    String
  kingdomId String

  lore    Lore    @relation(fields: [loreId], references: [id], onDelete: Cascade)
  kingdom Kingdom @relation(fields: [kingdomId], references: [id], onDelete: Cascade)

  @@unique([loreId, kingdomId])
}

model LoreCity {
  id      String @id @default(uuid())
  loreId  String
  cityId  String

  lore Lore @relation(fields: [loreId], references: [id], onDelete: Cascade)
  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([loreId, cityId])
}

model LorePlace {
  id      String @id @default(uuid())
  loreId  String
  placeId String

  lore  Lore  @relation(fields: [loreId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([loreId, placeId])
}

model LorePerson {
  id       String @id @default(uuid())
  loreId   String
  personId String

  lore   Lore            @relation(fields: [loreId], references: [id], onDelete: Cascade)
  person PersonOfInterest @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([loreId, personId])
}

model LoreOrganisation {
  id             String @id @default(uuid())
  loreId         String
  organisationId String

  lore         Lore         @relation(fields: [loreId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([loreId, organisationId])
}

model PlayerCharacter {
  id          String        @id @default(uuid())
  name        String
  class       DnDClass?
  level       Int           @default(1)
  race        Breed?
  background  String?
  alignment   DnDAlignment?
  imageUrl    String?
  description String?
  STR         Int           @default(10)
  DEX         Int           @default(10)
  CON         Int           @default(10)
  INT         Int           @default(10)
  WIS         Int           @default(10)
  CHA         Int           @default(10)
  pv          Int?
  pvMax       Int?
  ca          Int?
  initiative  Int?
  speed       Int?
  isForDM     Boolean       @default(false)
  showOnMap   Boolean       @default(true)
  kingdomId   String?
  cityId      String?
  districtId  String?
  placeId     String?

  kingdom      Kingdom?  @relation(fields: [kingdomId], references: [id])
  city         City?     @relation(fields: [cityId], references: [id])
  district     District? @relation(fields: [districtId], references: [id])
  place        Place?    @relation(fields: [placeId], references: [id])
  position     Position?
  skills       PlayerCharacterSkill[]
  savingThrows PlayerCharacterSavingThrow[]
  equipment    PlayerCharacterEquipmentItem[]
  spells       PlayerCharacterSpell[]
  combatants   Combatant[]
  campaigns    Campaign[]                     @relation("CampaignPlayers")
  familyMembers FamilyMember[]
}

model PlayerCharacterSkill {
  id                String  @id @default(uuid())
  playerCharacterId String
  name              String
  ability           String  @default("DEX") // STR, DEX, CON, INT, WIS, CHA
  proficient        Boolean @default(false)
  expertise         Boolean @default(false)

  playerCharacter PlayerCharacter @relation(fields: [playerCharacterId], references: [id], onDelete: Cascade)
}

model PlayerCharacterSavingThrow {
  id                String  @id @default(uuid())
  playerCharacterId String
  ability           String
  proficient        Boolean @default(false)

  playerCharacter PlayerCharacter @relation(fields: [playerCharacterId], references: [id], onDelete: Cascade)
}

model PlayerCharacterEquipmentItem {
  id                String  @id @default(uuid())
  playerCharacterId String
  name              String
  quantity          Int     @default(1)
  description       String?
  equipped          Boolean @default(false)

  playerCharacter PlayerCharacter @relation(fields: [playerCharacterId], references: [id], onDelete: Cascade)
}

model PlayerCharacterSpell {
  id                String  @id @default(uuid())
  playerCharacterId String
  name              String
  level             Int     @default(0)
  school            String?
  description       String?
  prepared          Boolean @default(false)

  playerCharacter PlayerCharacter @relation(fields: [playerCharacterId], references: [id], onDelete: Cascade)
}

enum CombatStatus {
  ACTIVE
  FINISHED
}

enum QuestStatus {
  A_FAIRE
  EN_COURS
  TERMINEE
  ECHOUEE
}

enum QuestStepStatus {
  A_FAIRE
  EN_COURS
  FAITE
}

model Combat {
  id              String       @id @default(uuid())
  name            String
  round           Int          @default(1)
  activeTurnIndex Int          @default(0)
  status          CombatStatus @default(ACTIVE)
  questStepId     String? // rencontre liée à une péripétie du module Campagne
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  combatants Combatant[]
  questStep  QuestStep? @relation(fields: [questStepId], references: [id], onDelete: SetNull)
}

model Combatant {
  id                String   @id @default(uuid())
  combatId          String
  name              String // snapshot dénormalisé (sert aussi aux monstres ad hoc)
  playerCharacterId String?
  personId          String?
  initiativeRoll    Int      @default(0)
  currentHp         Int      @default(0)
  maxHp             Int      @default(0)
  ca                Int?
  conditions        String[] @default([])
  createdAt         DateTime @default(now())

  combat          Combat            @relation(fields: [combatId], references: [id], onDelete: Cascade)
  playerCharacter PlayerCharacter?  @relation(fields: [playerCharacterId], references: [id], onDelete: SetNull)
  person          PersonOfInterest? @relation(fields: [personId], references: [id], onDelete: SetNull)
}

model Campaign {
  id          String   @id @default(uuid())
  name        String
  description String?
  color       String? // couleur d'accent optionnelle (hex)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quests   Quest[]
  players  PlayerCharacter[] @relation("CampaignPlayers")
  sessions GameSession[]
}

model Quest {
  id          String      @id @default(uuid())
  title       String
  description String?
  status      QuestStatus @default(A_FAIRE)
  notes       String?
  order       Int         @default(0)
  campaignId  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  campaign Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  steps    QuestStep[]
}

model QuestStep {
  id          String          @id @default(uuid())
  questId     String
  title       String
  description String?
  status      QuestStepStatus @default(A_FAIRE)
  optional    Boolean         @default(false) // péripétie facultative (interaction, jeu…)
  order       Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  quest   Quest    @relation(fields: [questId], references: [id], onDelete: Cascade)
  combats Combat[]
}

model GameSession {
  id         String   @id @default(uuid())
  date       DateTime
  title      String?
  summary    String?
  campaignId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
}
